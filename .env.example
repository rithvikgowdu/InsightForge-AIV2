# ==========================================
# InsightForge AI - Environment Configuration
# ==========================================

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL recommended; SQLite fallback supported)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightforge
# For local SQLite fallback:
# DATABASE_URL=sqlite:///./insightforge.db

# Authentication / Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# GitHub API Integration (Optional for higher rate limits)
GITHUB_TOKEN=your-github-personal-access-token-here

# LLM Configuration (Options: "ollama", "hosted", "deterministic_fallback")
LLM_PROVIDER=deterministic_fallback
LLM_MODEL=llama3.2
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE_URL=http://localhost:11434/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

